; startrek.mic - Star Trek fuer Busch Microtronic 2090 mit LED-Matrix (ESP2090 Studio), Version m02
; Matrix (Zeile 0 unten, Spalte 0 links):
;   Zeile 7: Energiebalken, Energie / 32 + 1 Pixel (8 = 224-255), Farben aus startrek_farben.py (Pixel 0-1 rot, 2-7 gruen)
;   Zeilen 0-3, Spalten 0-3: der Quadrant, ein Pixel je Sektor:
;   Farbe 5 Enterprise, 3 Klingone, 7 Basis, 9/1 Stern
;   Zeilen 0-2, Spalten 5-7: Sensor, 3 x 3 Quadranten um den eigenen (Mitte), in Galaxie-Orientierung;
;   gezeigt werden die beiden Nachbarn in der gewaehlten Richtung und gegenueber,
;   Farbe 3 Klingone, B Klingone und Basis, 8 Basis, sonst dunkel
; Display (nur beim Warten auf den Befehl): S N T = Sternzeit 0-F (alle 3-4 Aktionen eins weiter), Klingonen uebrig, Torpedos
; Start: Matrix wach (LED on; Emulator2090: m), startrek_farben.py starten, RESET, HALT NEXT 00 RUN.
;        Die Zeit von RESET bis RUN bestimmt die Galaxie.
; Befehle:
;   0 Navigation: Richtung, Entfernung 1-F (0 = Abbruch); 4 Energie je Feld
;   1 Sensor: Richtung; zeigt den Nachbarquadranten in dieser Richtung und den gegenueber bis zur naechsten Aktion; kostet 32 Energie
;   2 Phaser: Richtung, Energie 1-F; jede Stufe kostet 16 Energie und reicht 1 Feld weiter;
;     trifft das erste Objekt auf dem Weg; einen Klingonen in Entfernung e zerstoert er mit (16 - e) / 16
;   3-F Torpedo: zerstoert den Klingonen im eigenen Quadranten mit 75 % (1 Stueck, Basis fuellt auf 1 auf)
; Ein Klingone im eigenen Quadranten feuert nach jeder Aktion (auch nach dem Sensor): 0-30 Energie
; Sternzeit: nach 51 Aktionen (Anzeige F, dann Ueberlauf) ist das Spiel verloren.
; Basis: genau 1, im Quadranten Q = 4 qy + qx = sB
; Richtungen 8 9 A / 4 5 6 / 0 1 2, 5 = stehen.
; Ende: HALT an AF = gewonnen (Anzeige AF F00), HALT an B0 = verloren (B0 F00).
; 252 Schritte, 4 frei, keine verschachtelten CALLs.
;
; Register: R0 cy, R1 cx, R2 y, R3 x, R4 dx/Taste/ACK, R5 n/Nibble 1, R6 dy/Nibble 2/Matrixzeile, R7 Befehl/frei
; Quadrant: R8 ks, R9 bs, RA s1, RB s2, RC kal, RD Basis 8/0 bzw. Farbzaehler, RE es/Sektor, RF Code/Objekt
; M0-M3 Klingonen-Reihen (gedreht, Drehstand M6), M4 sK, M5 sB, M7 N
; Bank: M8 M9 Energie, MA MB Sternzeit, MC Torpedos, MD-MF Hilfsregister und Display (MD Torpedos, ME Klingonen, MF Sternzeit)

F02 ; 00 INIT:       DISOUT               Anzeige aus: 9,3 ms je Schritt, die Matrix braucht das
F05 ; 01             RND                  Zaehler RD RE RF: Zeit von RESET bis RUN
0D0 ; 02             MOV    rD,r0         Klingonen-Reihen D, E, nicht D, nicht E
0D2 ; 03             MOV    rD,r2
F82 ; 04             INV    r2
0E1 ; 05             MOV    rE,r1
0E3 ; 06             MOV    rE,r3
F83 ; 07             INV    r3
0D4 ; 08             MOV    rD,r4         sK = RD + RF: Sektoren haengen von allen drei Ziffern ab (bis 4096 Galaxien)
4F4 ; 09             ADD    rF,r4         RF ist bei kurzer Wartezeit klein, deshalb nur dazuaddiert
0E5 ; 0A             MOV    rE,r5         sB = RE
187 ; 0B             MOVI   8,r7          N = 8 Klingonen
F0D ; 0C             EXRL
F0E ; 0D REFILL:     EXRM                 REFILL: Energie 255, 1 Torpedo
1F8 ; 0E             MOVI   F,r8          Energie FFh = 255
1F9 ; 0F             MOVI   F,r9
11C ; 10             MOVI   1,rC          1 Torpedo
F0E ; 11             EXRM
BF1 ; 12 NEND:       CALL   CLR           alle Pixel aus (Farben bleiben)
BB1 ; 13 NL:         CALL   LQE           Quadrant der Enterprise laden (R0 R1 = Enterprise); Sensor springt hierher
90C ; 14             CMPI   0,rC          Klingone im Quadranten? (Flags ueberleben EXRM)
F0E ; 15             EXRM                 Bank bis zum Energiebalken
E1E ; 16             BRZ    NT
F05 ; 17             RND                  er feuert immer: Schaden RD = 0..15 (Zufall: Wartezeit der letzten Taste) ...
6D8 ; 18             SUB    rD,r8         ... zweimal abgezogen: 0..30
FC9 ; 19             SUBC   r9
DB0 ; 1A             BRC    DEAD          Energie unter 0 (HALT in der Bank ist egal)
6D8 ; 1B             SUB    rD,r8
FC9 ; 1C             SUBC   r9
DB0 ; 1D             BRC    DEAD          Energie unter 0
55A ; 1E NT:         ADDI   5,rA          Sternzeit: jede Aktion + 5 in RB:RA, nach 52 Zaehlungen Ueberlauf
FBB ; 1F             ADC    rB
DB0 ; 20             BRC    DEAD          Zeit abgelaufen
144 ; 21 DR2:        MOVI   4,r4          Energiebalken Zeile 7: ACK 4 (0, F) = Pixel 0, Zeichenart 2 (Bit an, Farbe vom Userscript); CMD geht auch in der Bank
105 ; 22             MOVI   0,r5
1F6 ; 23             MOVI   F,r6
BF3 ; 24             CALL   CMD
095 ; 25             MOV    r9,r5         R5 = obere Ziffer der Energie / 2 = Energie / 32 (0-7)
F95 ; 26             SHR    r5
F0D ; 27 EX:         EXRL                 Display vorbereiten: RE = N (Klingonen uebrig) aus M7 ...
07E ; 28             MOV    r7,rE
F0D ; 29             EXRL                 ... R0-R7 wieder wie vorher (R5, R6 fuer ACK 8)
0BF ; 2A             MOV    rB,rF         RF Sternzeit, RD Torpedos
0CD ; 2B             MOV    rC,rD
F0E ; 2C             EXRM                 Bank zurueck
184 ; 2D             MOVI   8,r4          ACK 8 (R5, F): Linie bis Pixel R5, Zeichenart 2 (Farbe vom Userscript)
BF3 ; 2E             CALL   CMD
90C ; 2F             CMPI   0,rC          Klingone tot: auf Stern 2 legen (Stern 2 wird zuletzt gezeichnet)
D32 ; 30             BRC    KOK
0B8 ; 31             MOV    rB,r8
90D ; 32 KOK:        CMPI   0,rD          keine Basis: ebenso
D35 ; 33             BRC    BOK
0B9 ; 34             MOV    rB,r9
19D ; 35 BOK:        MOVI   9,rD          Farben 9 7 5 3 1
1E4 ; 36 DLP:        MOVI   E,r4          Ring RA <- R9 <- RE <- R8 <- RB: s1, bs, es, ks, s2 (fehlende Eintraege auf s2, das zuletzt kommt: das Schiff blitzt nicht)
0D5 ; 37             MOV    rD,r5         ACK 14: Farbe = Zaehler (9 s1, 7 Basis, 5 Enterprise, 3 Klingone, 1 s2)
BF3 ; 38             CALL   CMD
0A5 ; 39             MOV    rA,r5         x = (s & 3) + 8 (Zeichenart 1)
335 ; 3A             ANDI   3,r5
585 ; 3B             ADDI   8,r5
0A6 ; 3C             MOV    rA,r6         y = s / 4
F96 ; 3D             SHR    r6
F96 ; 3E             SHR    r6
144 ; 3F             MOVI   4,r4          ACK 4: Pixel
BF3 ; 40             CALL   CMD
09A ; 41             MOV    r9,rA         naechster Eintrag
0E9 ; 42             MOV    rE,r9
08E ; 43             MOV    r8,rE
0B8 ; 44             MOV    rB,r8
5ED ; 45             ADDI   E,rD          Farbe - 2; nach der 1 weiter ins Hauptbild
D36 ; 46             BRC    DLP
F0E ; 47 MAIN:       EXRM                 Bank: Display zeigt RF RE RD = Sternzeit, Klingonen, Torpedos
F3D ; 48             DISP   3,rD
FF4 ; 49             KIN    r4            Befehl; R0 R1 = Enterprise seit LQE
F02 ; 4A             DISOUT               Display aus: Matrixbefehle brauchen 9,3 ms je Schritt
F0E ; 4B             EXRM
924 ; 4C             CMPI   2,r4          3-F: Torpedo; 0, 1, 2 lesen eine Richtung
D66 ; 4D             BRC    TORP
047 ; 4E NAV:        MOV    r4,r7         R7 = 0 Navigation, 1 Sensor, 2 Phaser
FF4 ; 4F             KIN    r4            Richtung 8 9 A / 4 5 6 / 0 1 2
046 ; 50             MOV    r4,r6         R6 = k / 4 = dy + 1 (beim Sensor die Matrixzeile 0-2)
F96 ; 51             SHR    r6
F96 ; 52             SHR    r6
334 ; 53             ANDI   3,r4          dx = (k & 3) - 1
714 ; 54             SUBI   1,r4
917 ; 55             CMPI   1,r7          Sensor: nur die Richtung
E7B ; 56             BRZ    SENS
716 ; 57             SUBI   1,r6          dy = R6 - 1
FF5 ; 58             KIN    r5            Entfernung bzw. Phaser-Energie (Felder) in R5
E47 ; 59             BRZ    MAIN          0: Abbruch
907 ; 5A             CMPI   0,r7
E61 ; 5B             BRZ    PSTEP         Navigation
057 ; 5C             MOV    r5,r7         Phaser: R7 = Stufen; beim Treffer ist R7 - R5 die Entfernung
F0E ; 5D             EXRM                 Energie - 16 je Stufe
659 ; 5E             SUB    r5,r9
F0E ; 5F TAIL:       EXRM                 gemeinsames Ende von Phaserkosten und Flugkosten
DB0 ; 60             BRC    DEAD          Energie unter 0
5F5 ; 61 PSTEP:      ADDI   F,r5          noch ein Feld? (Weg beginnt bei R0 R1 = Enterprise)
D9D ; 62             BRC    PS2
9FF ; 63 PEND:       CMPI   F,rF          Ende: Phaser hat einen Klingonen erreicht?
E70 ; 64             BRZ    HIT
C12 ; 65             GOTO   NEND          sonst weiter
90C ; 66 TORP:       CMPI   0,rC          Torpedo: Klingone im Quadranten? (RC von LQE in NL)
E47 ; 67             BRZ    MAIN          nein: nichts passiert
F0E ; 68             EXRM                 Bank
71C ; 69             SUBI   1,rC          Torpedos - 1 ...
FBC ; 6A             ADC    rC            ... war es 0: F + 1 = 0 mit Carry
F0E ; 6B             EXRM
D47 ; 6C             BRC    MAIN          kein Torpedo: nichts passiert
F05 ; 6D             RND                  Zufall 0-15 in RD (RD-RF werden danach neu berechnet)
14E ; 6E             MOVI   4,rE          Torpedo trifft bei RD >= 4: 75 %
C73 ; 6F             GOTO   HC
F05 ; 70 HIT:        RND                  Phaser: Zufall 0-15 in RD
07E ; 71             MOV    r7,rE         RE = Entfernung = Stufen - Rest
65E ; 72             SUB    r5,rE
8DE ; 73 HC:         CMP    rD,rE         RD < RE: verfehlt
D12 ; 74             BRC    NEND          verfehlt: der Klingone bleibt und schiesst
F0D ; 75 KILL:       EXRL                 Abschuss: Reihe liegt gedreht in R0
6C0 ; 76             SUB    rC,r0         Maskenbit (RC) loeschen
717 ; 77             SUBI   1,r7          N - 1, Zero = alle besiegt
F0D ; 78             EXRL
EAF ; 79             BRZ    WIN
C12 ; 7A             GOTO   NEND
F0E ; 7B SENS:       EXRM                 Sensor: kostet 32 Energie (zwei Phaserstufen)
729 ; 7C             SUBI   2,r9
F0E ; 7D             EXRM
DB0 ; 7E             BRC    DEAD          Energie unter 0
041 ; 7F             MOV    r4,r1         R1 = dx; R6 = dy + 1 kommt aus NAV
100 ; 80             MOVI   0,r0          R0 zaehlt die beiden Durchgaenge
BF1 ; 81             CALL   CLR           loeschen (sonst bliebe ein alter Energiebalken stehen)
06E ; 82 SL:         MOV    r6,rE         Quadrant in Richtung: RE = y + 4 R6 - 4 = y + 4 dy
FAE ; 83             SHL    rE
FAE ; 84             SHL    rE
42E ; 85             ADD    r2,rE
74E ; 86             SUBI   4,rE
01F ; 87             MOV    r1,rF         RF = x + 4 dx
FAF ; 88             SHL    rF
FAF ; 89             SHL    rF
43F ; 8A             ADD    r3,rF
BB5 ; 8B             CALL   LQ2           Quadrant laden (ab LQ2, RE RF vorgegeben): RC Klingone, RD Basis 8/0
0D5 ; 8C             MOV    rD,r5         Farbe 8 Basis oder 0 leer (Farbe 0 = Pixel aus)
90C ; 8D             CMPI   0,rC          Klingone?
E90 ; 8E             BRZ    SP
535 ; 8F             ADDI   3,r5          Klingone: Farbe 3, mit Basis 3 + 8 = B
1E4 ; 90 SP:         MOVI   E,r4          ACK 14: Farbe
BF3 ; 91             CALL   CMD
144 ; 92             MOVI   4,r4          ACK 4: Pixel (dx + E, R6): Spalte 5-7, Zeichenart 1
015 ; 93             MOV    r1,r5
5E5 ; 94             ADDI   E,r5
BF3 ; 95             CALL   CMD
F86 ; 96             INV    r6            Gegenrichtung: R6 = 2 - R6
536 ; 97             ADDI   3,r6
F81 ; 98             INV    r1            dx = -dx
511 ; 99             ADDI   1,r1
710 ; 9A             SUBI   1,r0          zweiter Durchgang?
D82 ; 9B             BRC    SL
C13 ; 9C             GOTO   NL            Klingone feuert, Bild neu ohne Loeschen: Sensorpixel bleiben bis zur naechsten Aktion
441 ; 9D PS2:        ADD    r4,r1         naechstes Feld
460 ; 9E             ADD    r6,r0
BB3 ; 9F             CALL   LQ            Quadrant des Feldes laden + Inhalt (RF)
90F ; A0             CMPI   0,rF          frei?
EA7 ; A1             BRZ    PFREE
907 ; A2             CMPI   0,r7          Phaser trifft das erste Objekt
D63 ; A3             BRC    PEND
98F ; A4             CMPI   8,rF          Basis?
E0D ; A5             BRZ    REFILL        Basis: andocken
C12 ; A6             GOTO   NEND          Stern oder Klingone: Flug endet davor
907 ; A7 PFREE:      CMPI   0,r7          Phaser fliegt weiter
D61 ; A8             BRC    PSTEP
002 ; A9             MOV    r0,r2         Enterprise zieht weiter
013 ; AA             MOV    r1,r3
F0E ; AB             EXRM                 4 Energie je Sektor
748 ; AC             SUBI   4,r8
FC9 ; AD             SUBC   r9
C5F ; AE             GOTO   TAIL          Energie pruefen, weiter mit PSTEP
F00 ; AF WIN:        HALT                 Ende: alle Klingonen besiegt
F00 ; B0 DEAD:       HALT                 Ende: Energie unter 0
020 ; B1 LQE:        MOV    r2,r0         Quadrant der Enterprise
031 ; B2             MOV    r3,r1
00E ; B3 LQ:         MOV    r0,rE         RE = cy, RF = cx
01F ; B4             MOV    r1,rF
F0D ; B5 LQ2:        EXRL                 Kontext: R0-R3 Reihen, R4 sK, R5 sB, R6 Drehstand
3CE ; B6             ANDI   C,rE          RE = 4 qy
0E8 ; B7             MOV    rE,r8         R8 zaehlt bis Q = 4 qy + qx
11B ; B8             MOVI   1,rB          RB wird 1 << qx
CBC ; B9             GOTO   LM2
4BB ; BA LM1:        ADD    rB,rB
518 ; BB             ADDI   1,r8          Q + 1
5CF ; BC LM2:        ADDI   C,rF          RF - 4 mit Uebertrag, solange RF >= 4: qx Durchlaeufe
DBA ; BD             BRC    LM1
0E9 ; BE             MOV    rE,r9         R9 = 4 qy ...
669 ; BF             SUB    r6,r9         ... - Drehstand: so oft drehen
0E6 ; C0             MOV    rE,r6         Drehstand M6 = 4 qy
CC7 ; C1             GOTO   LT
00E ; C2 LR:         MOV    r0,rE         R0 <- R1 <- R2 <- R3 <- R0
010 ; C3             MOV    r1,r0
021 ; C4             MOV    r2,r1
032 ; C5             MOV    r3,r2
0E3 ; C6             MOV    rE,r3
5C9 ; C7 LT:         ADDI   C,r9
DC2 ; C8             BRC    LR
00C ; C9             MOV    r0,rC
2BC ; CA LG:         AND    rB,rC         RC = kal
18D ; CB             MOVI   8,rD          eine Basis: im Quadranten Q = sB ist RD = 8 ...
858 ; CC             CMP    r5,r8
ECF ; CD             BRZ    LB
10D ; CE             MOVI   0,rD          ... sonst RD = 0
448 ; CF LB:         ADD    r4,r8         ks = rotl(Q + sK)
FA8 ; D0             SHL    r8
FB8 ; D1             ADC    r8
089 ; D2             MOV    r8,r9         bs = ks + RD (ohne Basis gleich ks, vom Klingonen verdeckt)
4D9 ; D3             ADD    rD,r9
08A ; D4             MOV    r8,rA         Stern 1 = rotl(ks + sB)
45A ; D5             ADD    r5,rA
FAA ; D6             SHL    rA
FBA ; D7             ADC    rA
0AB ; D8             MOV    rA,rB         Stern 2 = s1 + ks
48B ; D9             ADD    r8,rB
F0D ; DA             EXRL                 Kontext zurueck, weiter mit CELLG
00E ; DB CELLG:      MOV    r0,rE         Sektor s = 4 cy + (cx & 3), 4 cy rechnet von selbst modulo 16
4EE ; DC             ADD    rE,rE
4EE ; DD             ADD    rE,rE
01F ; DE             MOV    r1,rF
33F ; DF             ANDI   3,rF
4FE ; E0             ADD    rF,rE
1FF ; E1 CELL:       MOVI   F,rF          Klingone?
88E ; E2             CMP    r8,rE
EEE ; E3             BRZ    CK
18F ; E4             MOVI   8,rF          Basis?
89E ; E5             CMP    r9,rE
EED ; E6             BRZ    CRET
11F ; E7 CS:         MOVI   1,rF          Stern?
8AE ; E8             CMP    rA,rE
EED ; E9             BRZ    CRET
8BE ; EA             CMP    rB,rE
EED ; EB             BRZ    CRET
10F ; EC             MOVI   0,rF          leer
F07 ; ED CRET:       RET
90C ; EE CK:         CMPI   0,rC          Klingone tot: Basis-Pruefung ueberspringen
EE7 ; EF             BRZ    CS
F07 ; F0             RET
134 ; F1 CLR:        MOVI   3,r4          ACK 3,3: alle Pixel aus, Farben bleiben; weiter in CMD
135 ; F2             MOVI   3,r5
107 ; F3 CMD:        MOVI   0,r7          Matrixbefehl R4 mit R5, R6: erst 0 ausgeben
FE7 ; F4             DOT    r7
FD7 ; F5 CW:         DIN    r7            auf REQ warten
317 ; F6             ANDI   1,r7
EF5 ; F7             BRZ    CW
FE4 ; F8             DOT    r4            ACK
FE5 ; F9             DOT    r5            1. Nibble
FE6 ; FA             DOT    r6            2. Nibble (bei ACK 3/14 bedeutungslos)
F07 ; FB             RET
