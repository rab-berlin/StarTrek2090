; startrek.mic - Star Trek fuer Busch Microtronic 2090 mit LED-Matrix (ESP2090 Studio), Version m02
; Matrix (Zeile 0 unten, Spalte 0 links):
;   Zeile 7: Energiebalken, Energie / 32 + 1 Pixel (8 = 224-255), Farben aus startrek_farben.py (Pixel 0-1 rot, 2-7 gruen)
;   Zeilen 0-3, Spalten 0-3: der Quadrant, ein Pixel je Sektor:
;   Farbe 5 Enterprise, 3 Klingone, 7 Basis, 9/1 Stern
;   Zeilen 0-2, Spalten 5-7: Sensor, 3 x 3 Quadranten um den eigenen (Mitte), in Galaxie-Orientierung;
;   gezeigt werden die beiden Nachbarn in der gewaehlten Richtung und gegenueber,
;   Farbe 3 Klingone, B Klingone und Basis, 8 Basis, sonst dunkel
; Display (nur beim Warten auf den Befehl): S 0 T = Sternzeit 0-F (alle 3-4 Aktionen eins weiter), Trennnull, Torpedos
; Start: Matrix wach (LED on; Emulator2090: m), startrek_farben.py starten, RESET, HALT NEXT 00 RUN.
;        Die Zeit von RESET bis RUN bestimmt die Galaxie.
; Befehle:
;   0 Navigation: Richtung, Entfernung 1-F (0 = Abbruch); 4 Energie je Feld
;   1 Sensor: Richtung; zeigt den Nachbarquadranten in dieser Richtung und den gegenueber bis zur naechsten Aktion; kostet 32 Energie
;   2 Phaser: Richtung, Energie 1-F; jede Stufe kostet 16 Energie und reicht 1 Feld weiter;
;     trifft das erste Objekt auf dem Weg, nur ein Klingone wird zerstoert
;   3-F Torpedo: zerstoert den Klingonen im eigenen Quadranten sicher (1 Stueck, Basis fuellt auf 1 auf)
; Ein Klingone im eigenen Quadranten feuert nach jeder Aktion (auch nach dem Sensor): 0-30 Energie
; Sternzeit: nach 51 Aktionen (Anzeige F, dann Ueberlauf) ist das Spiel verloren.
; Basis: genau 1, im Quadranten Q = 4 qy + qx = sB
; Richtungen 8 9 A / 4 5 6 / 0 1 2, 5 = stehen.
; Ende: HALT an A3 = gewonnen (Anzeige A3 F00), HALT an A4 = verloren (A4 F00).
; 240 Schritte, 16 frei, keine verschachtelten CALLs.
;
; Register: R0 cy, R1 cx, R2 y, R3 x, R4 dx/Taste/ACK, R5 n/Nibble 1, R6 dy/Nibble 2/Matrixzeile, R7 Befehl/frei
; Quadrant: R8 ks, R9 bs, RA s1, RB s2, RC kal, RD Basis 8/0 bzw. Farbzaehler, RE es/Sektor, RF Code/Objekt
; M0-M3 Klingonen-Reihen (gedreht, Drehstand M6), M4 sK, M5 sB, M7 N
; Bank: M8 M9 Energie, MA MB Sternzeit, MC Torpedos, MD-MF Hilfsregister und Display (MD Torpedos, ME 0, MF Sternzeit)

F02 ; 00 INIT:       DISOUT               Anzeige aus: 9,3 ms je Schritt, die Matrix braucht das
F05 ; 01             RND                  Zaehler RD RE RF: Zeit von RESET bis RUN
0D0 ; 02             MOV    rD,r0         Klingonen-Reihen D, E, nicht D, nicht E
0D2 ; 03             MOV    rD,r2
F82 ; 04             INV    r2
0E1 ; 05             MOV    rE,r1
0E3 ; 06             MOV    rE,r3
F83 ; 07             INV    r3
0D4 ; 08             MOV    rD,r4         sK = RD (RF ist bei kurzer Wartezeit klein)
0E5 ; 09             MOV    rE,r5         sB = RE
187 ; 0A             MOVI   8,r7          N = 8 Klingonen
F0D ; 0B             EXRL
F0E ; 0C REFILL:     EXRM                 REFILL: Energie 255, 1 Torpedo
1F8 ; 0D             MOVI   F,r8          Energie FFh = 255
1F9 ; 0E             MOVI   F,r9
11C ; 0F             MOVI   1,rC          1 Torpedo
F0E ; 10             EXRM
BE5 ; 11 NEND:       CALL   CLR           alle Pixel aus (Farben bleiben)
BA5 ; 12 NL:         CALL   LQE           Quadrant der Enterprise laden (R0 R1 = Enterprise); Sensor springt hierher
90C ; 13             CMPI   0,rC          Klingone im Quadranten? (Flags ueberleben EXRM)
F0E ; 14             EXRM                 Bank bis zum Energiebalken
E1D ; 15             BRZ    NT
F05 ; 16             RND                  er feuert immer: Schaden RD = 0..15 (Zufall: Wartezeit der letzten Taste) ...
6D8 ; 17             SUB    rD,r8         ... zweimal abgezogen: 0..30
FC9 ; 18             SUBC   r9
DA4 ; 19             BRC    DEAD          Energie unter 0 (HALT in der Bank ist egal)
6D8 ; 1A             SUB    rD,r8
FC9 ; 1B             SUBC   r9
DA4 ; 1C             BRC    DEAD          Energie unter 0
55A ; 1D NT:         ADDI   5,rA          Sternzeit: jede Aktion + 5 in RB:RA, nach 52 Zaehlungen Ueberlauf
FBB ; 1E             ADC    rB
DA4 ; 1F             BRC    DEAD          Zeit abgelaufen
144 ; 20 DR2:        MOVI   4,r4          Energiebalken Zeile 7: ACK 4 (0, F) = Pixel 0, Zeichenart 2 (Bit an, Farbe vom Userscript); CMD geht auch in der Bank
105 ; 21             MOVI   0,r5
1F6 ; 22             MOVI   F,r6
BE7 ; 23             CALL   CMD
095 ; 24             MOV    r9,r5         R5 = obere Ziffer der Energie / 2 = Energie / 32 (0-7)
F95 ; 25             SHR    r5
10E ; 26 EX:         MOVI   0,rE          Display vorbereiten: RF Sternzeit, RE 0, RD Torpedos
0BF ; 27             MOV    rB,rF
0CD ; 28             MOV    rC,rD
F0E ; 29             EXRM                 Bank zurueck
184 ; 2A             MOVI   8,r4          ACK 8 (R5, F): Linie bis Pixel R5, Zeichenart 2 (Farbe vom Userscript)
BE7 ; 2B             CALL   CMD
90C ; 2C             CMPI   0,rC          Klingone tot: auf Stern 2 legen (Stern 2 wird zuletzt gezeichnet)
D2F ; 2D             BRC    KOK
0B8 ; 2E             MOV    rB,r8
90D ; 2F KOK:        CMPI   0,rD          keine Basis: ebenso
D32 ; 30             BRC    BOK
0B9 ; 31             MOV    rB,r9
19D ; 32 BOK:        MOVI   9,rD          Farben 9 7 5 3 1
1E4 ; 33 DLP:        MOVI   E,r4          Ring RA <- R9 <- RE <- R8 <- RB: s1, bs, es, ks, s2 (fehlende Eintraege auf s2, das zuletzt kommt: das Schiff blitzt nicht)
0D5 ; 34             MOV    rD,r5         ACK 14: Farbe = Zaehler (9 s1, 7 Basis, 5 Enterprise, 3 Klingone, 1 s2)
BE7 ; 35             CALL   CMD
0A5 ; 36             MOV    rA,r5         x = (s & 3) + 8 (Zeichenart 1)
335 ; 37             ANDI   3,r5
585 ; 38             ADDI   8,r5
0A6 ; 39             MOV    rA,r6         y = s / 4
F96 ; 3A             SHR    r6
F96 ; 3B             SHR    r6
144 ; 3C             MOVI   4,r4          ACK 4: Pixel
BE7 ; 3D             CALL   CMD
09A ; 3E             MOV    r9,rA         naechster Eintrag
0E9 ; 3F             MOV    rE,r9
08E ; 40             MOV    r8,rE
0B8 ; 41             MOV    rB,r8
5ED ; 42             ADDI   E,rD          Farbe - 2; nach der 1 weiter ins Hauptbild
D33 ; 43             BRC    DLP
F0E ; 44 MAIN:       EXRM                 Bank: Display zeigt RF RE RD = Sternzeit, 0, Torpedos
F3D ; 45             DISP   3,rD
FF4 ; 46             KIN    r4            Befehl; R0 R1 = Enterprise seit LQE
F02 ; 47             DISOUT               Display aus: Matrixbefehle brauchen 9,3 ms je Schritt
F0E ; 48             EXRM
924 ; 49             CMPI   2,r4          3-F: Torpedo; 0, 1, 2 lesen eine Richtung
D62 ; 4A             BRC    TORP
047 ; 4B NAV:        MOV    r4,r7         R7 = 0 Navigation, 1 Sensor, 2 Phaser
FF4 ; 4C             KIN    r4            Richtung 8 9 A / 4 5 6 / 0 1 2
046 ; 4D             MOV    r4,r6         R6 = k / 4 = dy + 1 (beim Sensor die Matrixzeile 0-2)
F96 ; 4E             SHR    r6
F96 ; 4F             SHR    r6
334 ; 50             ANDI   3,r4          dx = (k & 3) - 1
714 ; 51             SUBI   1,r4
917 ; 52             CMPI   1,r7          Sensor: nur die Richtung
E6F ; 53             BRZ    SENS
716 ; 54             SUBI   1,r6          dy = R6 - 1
FF5 ; 55             KIN    r5            Entfernung bzw. Phaser-Energie (Felder) in R5
E44 ; 56             BRZ    MAIN          0: Abbruch
907 ; 57             CMPI   0,r7
E5D ; 58             BRZ    PSTEP         Navigation
F0E ; 59             EXRM                 Phaser: Energie - 16 je Feld Reichweite
659 ; 5A             SUB    r5,r9
F0E ; 5B TAIL:       EXRM                 gemeinsames Ende von Phaserkosten und Flugkosten
DA4 ; 5C             BRC    DEAD          Energie unter 0
5F5 ; 5D PSTEP:      ADDI   F,r5          noch ein Feld? (Weg beginnt bei R0 R1 = Enterprise)
D91 ; 5E             BRC    PS2
9FF ; 5F PEND:       CMPI   F,rF          Ende: Phaser hat Klingonen getroffen?
E69 ; 60             BRZ    KILL
C11 ; 61             GOTO   NEND          sonst weiter
90C ; 62 TORP:       CMPI   0,rC          Torpedo: Klingone im Quadranten? (RC von LQE in DRAW)
E44 ; 63             BRZ    MAIN          nein: nichts passiert
F0E ; 64             EXRM                 Bank
71C ; 65             SUBI   1,rC          Torpedos - 1 ...
FBC ; 66             ADC    rC            ... war es 0: F + 1 = 0 mit Carry
F0E ; 67             EXRM
D44 ; 68             BRC    MAIN          kein Torpedo: nichts passiert; sonst trifft er sicher
F0D ; 69 KILL:       EXRL                 Abschuss: Reihe liegt gedreht in R0
6C0 ; 6A             SUB    rC,r0         Maskenbit (RC) loeschen
717 ; 6B             SUBI   1,r7          N - 1, Zero = alle besiegt
F0D ; 6C             EXRL
EA3 ; 6D             BRZ    WIN
C11 ; 6E             GOTO   NEND
F0E ; 6F SENS:       EXRM                 Sensor: kostet 32 Energie (zwei Phaserstufen)
729 ; 70             SUBI   2,r9
F0E ; 71             EXRM
DA4 ; 72             BRC    DEAD          Energie unter 0
041 ; 73             MOV    r4,r1         R1 = dx; R6 = dy + 1 kommt aus NAV
100 ; 74             MOVI   0,r0          R0 zaehlt die beiden Durchgaenge
BE5 ; 75             CALL   CLR           loeschen (sonst bliebe ein alter Energiebalken stehen)
06E ; 76 SL:         MOV    r6,rE         Quadrant in Richtung: RE = y + 4 R6 - 4 = y + 4 dy
FAE ; 77             SHL    rE
FAE ; 78             SHL    rE
42E ; 79             ADD    r2,rE
74E ; 7A             SUBI   4,rE
01F ; 7B             MOV    r1,rF         RF = x + 4 dx
FAF ; 7C             SHL    rF
FAF ; 7D             SHL    rF
43F ; 7E             ADD    r3,rF
BA9 ; 7F             CALL   LQ2           Quadrant laden (ab LQ2, RE RF vorgegeben): RC Klingone, RD Basis 8/0
0D5 ; 80             MOV    rD,r5         Farbe 8 Basis oder 0 leer (Farbe 0 = Pixel aus)
90C ; 81             CMPI   0,rC          Klingone?
E84 ; 82             BRZ    SP
535 ; 83             ADDI   3,r5          Klingone: Farbe 3, mit Basis 3 + 8 = B
1E4 ; 84 SP:         MOVI   E,r4          ACK 14: Farbe
BE7 ; 85             CALL   CMD
144 ; 86             MOVI   4,r4          ACK 4: Pixel (dx + E, R6): Spalte 5-7, Zeichenart 1
015 ; 87             MOV    r1,r5
5E5 ; 88             ADDI   E,r5
BE7 ; 89             CALL   CMD
F86 ; 8A             INV    r6            Gegenrichtung: R6 = 2 - R6
536 ; 8B             ADDI   3,r6
F81 ; 8C             INV    r1            dx = -dx
511 ; 8D             ADDI   1,r1
710 ; 8E             SUBI   1,r0          zweiter Durchgang?
D76 ; 8F             BRC    SL
C12 ; 90             GOTO   NL            Klingone feuert, Bild neu ohne Loeschen: Sensorpixel bleiben bis zur naechsten Aktion
441 ; 91 PS2:        ADD    r4,r1         naechstes Feld
460 ; 92             ADD    r6,r0
BA7 ; 93             CALL   LQ            Quadrant des Feldes laden + Inhalt (RF)
90F ; 94             CMPI   0,rF          frei?
E9B ; 95             BRZ    PFREE
907 ; 96             CMPI   0,r7          Phaser trifft das erste Objekt
D5F ; 97             BRC    PEND
98F ; 98             CMPI   8,rF          Basis?
E0C ; 99             BRZ    REFILL        Basis: andocken
C11 ; 9A             GOTO   NEND          Stern oder Klingone: Flug endet davor
907 ; 9B PFREE:      CMPI   0,r7          Phaser fliegt weiter
D5D ; 9C             BRC    PSTEP
002 ; 9D             MOV    r0,r2         Enterprise zieht weiter
013 ; 9E             MOV    r1,r3
F0E ; 9F             EXRM                 4 Energie je Sektor
748 ; A0             SUBI   4,r8
FC9 ; A1             SUBC   r9
C5B ; A2             GOTO   TAIL          Energie pruefen, weiter mit PSTEP
F00 ; A3 WIN:        HALT                 Ende: alle Klingonen besiegt
F00 ; A4 DEAD:       HALT                 Ende: Energie unter 0
020 ; A5 LQE:        MOV    r2,r0         Quadrant der Enterprise
031 ; A6             MOV    r3,r1
00E ; A7 LQ:         MOV    r0,rE         RE = cy, RF = cx
01F ; A8             MOV    r1,rF
F0D ; A9 LQ2:        EXRL                 Kontext: R0-R3 Reihen, R4 sK, R5 sB, R6 Drehstand
3CE ; AA             ANDI   C,rE          RE = 4 qy
0E8 ; AB             MOV    rE,r8         R8 zaehlt bis Q = 4 qy + qx
11B ; AC             MOVI   1,rB          RB wird 1 << qx
CB0 ; AD             GOTO   LM2
4BB ; AE LM1:        ADD    rB,rB
518 ; AF             ADDI   1,r8          Q + 1
5CF ; B0 LM2:        ADDI   C,rF          RF - 4 mit Uebertrag, solange RF >= 4: qx Durchlaeufe
DAE ; B1             BRC    LM1
0E9 ; B2             MOV    rE,r9         R9 = 4 qy ...
669 ; B3             SUB    r6,r9         ... - Drehstand: so oft drehen
0E6 ; B4             MOV    rE,r6         Drehstand M6 = 4 qy
CBB ; B5             GOTO   LT
00E ; B6 LR:         MOV    r0,rE         R0 <- R1 <- R2 <- R3 <- R0
010 ; B7             MOV    r1,r0
021 ; B8             MOV    r2,r1
032 ; B9             MOV    r3,r2
0E3 ; BA             MOV    rE,r3
5C9 ; BB LT:         ADDI   C,r9
DB6 ; BC             BRC    LR
00C ; BD             MOV    r0,rC
2BC ; BE LG:         AND    rB,rC         RC = kal
18D ; BF             MOVI   8,rD          eine Basis: im Quadranten Q = sB ist RD = 8 ...
858 ; C0             CMP    r5,r8
EC3 ; C1             BRZ    LB
10D ; C2             MOVI   0,rD          ... sonst RD = 0
448 ; C3 LB:         ADD    r4,r8         ks = rotl(Q + sK)
FA8 ; C4             SHL    r8
FB8 ; C5             ADC    r8
089 ; C6             MOV    r8,r9         bs = ks + RD (ohne Basis gleich ks, vom Klingonen verdeckt)
4D9 ; C7             ADD    rD,r9
08A ; C8             MOV    r8,rA         Stern 1 = rotl(ks + sB)
45A ; C9             ADD    r5,rA
FAA ; CA             SHL    rA
FBA ; CB             ADC    rA
0AB ; CC             MOV    rA,rB         Stern 2 = s1 + ks
48B ; CD             ADD    r8,rB
F0D ; CE             EXRL                 Kontext zurueck, weiter mit CELLG
00E ; CF CELLG:      MOV    r0,rE         Sektor s = 4 cy + (cx & 3), 4 cy rechnet von selbst modulo 16
4EE ; D0             ADD    rE,rE
4EE ; D1             ADD    rE,rE
01F ; D2             MOV    r1,rF
33F ; D3             ANDI   3,rF
4FE ; D4             ADD    rF,rE
1FF ; D5 CELL:       MOVI   F,rF          Klingone?
88E ; D6             CMP    r8,rE
EE2 ; D7             BRZ    CK
18F ; D8             MOVI   8,rF          Basis?
89E ; D9             CMP    r9,rE
EE1 ; DA             BRZ    CRET
11F ; DB CS:         MOVI   1,rF          Stern?
8AE ; DC             CMP    rA,rE
EE1 ; DD             BRZ    CRET
8BE ; DE             CMP    rB,rE
EE1 ; DF             BRZ    CRET
10F ; E0             MOVI   0,rF          leer
F07 ; E1 CRET:       RET
90C ; E2 CK:         CMPI   0,rC          Klingone tot: Basis-Pruefung ueberspringen
EDB ; E3             BRZ    CS
F07 ; E4             RET
134 ; E5 CLR:        MOVI   3,r4          ACK 3,3: alle Pixel aus, Farben bleiben; weiter in CMD
135 ; E6             MOVI   3,r5
107 ; E7 CMD:        MOVI   0,r7          Matrixbefehl R4 mit R5, R6: erst 0 ausgeben
FE7 ; E8             DOT    r7
FD7 ; E9 CW:         DIN    r7            auf REQ warten
317 ; EA             ANDI   1,r7
EE9 ; EB             BRZ    CW
FE4 ; EC             DOT    r4            ACK
FE5 ; ED             DOT    r5            1. Nibble
FE6 ; EE             DOT    r6            2. Nibble (bei ACK 3/14 bedeutungslos)
F07 ; EF             RET
